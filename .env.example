# ---------------------------------------------------------------------------
# Vaani AI — environment variables (copy to .env and fill in). NEVER commit .env
# ---------------------------------------------------------------------------

# Database (matches docker-compose.yml; host port 5433 to avoid local PG clashes)
DATABASE_URL="postgresql://vaani:vaani@localhost:5433/vaani?schema=public"

# API server
API_PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGIN="http://localhost:5173"

# Auth — generate strong random values in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="dev-only-change-me-32-chars-minimum-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# AI provider abstraction. AI keys live ONLY on the backend, never in the browser.
# AI_PROVIDER: mock | openai   (defaults to `mock` — the offline/deterministic path)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
# Chat model for the real OpenAI path (ignored by the mock). e.g. gpt-4o | gpt-4o-mini
OPENAI_MODEL="gpt-4o-mini"
# Degrade gracefully to the mock provider on a transient OpenAI outage (429/5xx/timeout)
AI_FALLBACK_TO_MOCK="false"

# Real speech (opt-in). SPEECH_PROVIDER falls back to AI_PROVIDER when unset.
# Real STT/TTS run only when the selector is `openai` AND OPENAI_API_KEY is present.
SPEECH_PROVIDER=""
OPENAI_STT_MODEL="whisper-1"
OPENAI_TTS_MODEL="tts-1"
OPENAI_TTS_VOICE="alloy"

# ---------------------------------------------------------------------------
# Meeting AI automation — calendar (read-only) + reminders.
# CALENDAR_PROVIDER: mock | outlook  (defaults to `mock` — offline/deterministic).
# The REAL Outlook (Microsoft Graph) calendar activates ONLY when
# CALENDAR_PROVIDER=outlook AND MS_GRAPH_ACCESS_TOKEN is set. The calendar is
# strictly READ-ONLY (Vaani never writes back). Minting the Graph token (Azure AD /
# MSAL OAuth sign-in) is out of scope — it requires an Azure app registration with
# delegated Calendars.Read + OnlineMeetings.Read consent. NEVER commit a real token.
# ---------------------------------------------------------------------------
CALENDAR_PROVIDER="mock"
MS_GRAPH_ACCESS_TOKEN=""
MS_GRAPH_BASE_URL="https://graph.microsoft.com/v1.0"
# Default reminder window (minutes before start) when a user has no per-user setting.
MEETING_REMINDER_MINUTES=10

# ── Meeting capture (Microsoft Teams via Graph) ──────────────────────────────
# Disabled by default — dev/tests need NO Azure credentials. Turn on only in an
# org that allows Teams recording/transcription. See docs/MEETING_CAPTURE.md.
# MEETING_CAPTURE_PROVIDER: graph | local | disabled (default)
MEETING_CAPTURE_PROVIDER="disabled"
# Master switch for the Graph provider (must be true AND creds present to activate).
MEETING_CAPTURE_GRAPH="false"
# Azure AD app (client-credentials). Needs admin-consented application permissions:
# OnlineMeetings.Read.All, OnlineMeetingTranscript.Read.All, OnlineMeetingRecording.Read.All
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
# Optional Graph base override for sovereign clouds.
GRAPH_BASE_URL="https://graph.microsoft.com/v1.0"

# ── Optional web research (Apify) — INDEPENDENT of OpenAI/Azure, off by default ──
# APIFY_API_TOKEN is used only for Apify. See docs/APIFY_SETUP.md.
APIFY_ENABLED="false"
APIFY_API_TOKEN=""
APIFY_ACTOR_ID="apify~google-search-scraper"

# Google OAuth (Phase 1 stubbed — fill in when OAuth phase begins)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Object storage (audio/images) — abstraction only in Phase 1
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Frontend (Vite) — only VITE_* vars are exposed to the browser. No secrets here.
VITE_API_URL="http://localhost:4000"
# Opt-in server-side speech path on the Call page (real STT/TTS via the backend).
# Default false → the browser Web Speech API stays the default/offline path.
VITE_SERVER_SPEECH="false"

# ---------------------------------------------------------------------------
# Production deployment (docker-compose.prod.yml). Copy this file to .env.prod and
# fill in REAL secrets there (NEVER commit .env.prod). See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------
# Postgres credentials for the prod `db` service (POSTGRES_PASSWORD is required).
POSTGRES_USER="vaani"
POSTGRES_PASSWORD=""
POSTGRES_DB="vaani"
# Public host port the web (nginx) container binds to.
WEB_PORT=80
# In prod, DATABASE_URL points at the compose `db` service (host `db`, port 5432).
# Example: postgresql://vaani:${POSTGRES_PASSWORD}@db:5432/vaani?schema=public
