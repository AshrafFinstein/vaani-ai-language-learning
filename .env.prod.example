# ─────────────────────────────────────────────────────────────────────────────
# Production env template. Copy to `.env.prod` and fill in REAL values.
#   cp .env.prod.example .env.prod
# NEVER commit .env.prod (it's gitignored). Use strong, unique secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (the compose `db` service) ──────────────────────────────────────
POSTGRES_USER=vaani
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=vaani
# DATABASE_URL defaults to the compose `db` service; override only for an external DB.
# DATABASE_URL=postgresql://vaani:CHANGE_ME@db:5432/vaani?schema=public

# ── Auth / API ───────────────────────────────────────────────────────────────
# JWT_SECRET MUST be >= 16 chars (use 32+ random chars). Generate one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_random_characters_please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Public URL / TLS (Caddy overlay: docker-compose.tls.yml) ──────────────────
# Your domain (DNS A record must point at this server). Caddy auto-provisions HTTPS.
DOMAIN=vaani.example.com
# Email for Let's Encrypt expiry notices.
TLS_EMAIL=you@example.com
# CORS: the browser origin. With TLS this is https://<your domain>.
CORS_ORIGIN=https://vaani.example.com
# Host port for the web container when running WITHOUT the TLS overlay (plain HTTP).
WEB_PORT=8080

# ── AI / speech (leave as mock to run without a key) ─────────────────────────
# Set AI_PROVIDER=openai + OPENAI_API_KEY for real ChatGPT; SPEECH_PROVIDER=openai for
# real Whisper STT / OpenAI TTS. Keys live ONLY here (server-side), never in the client.
AI_PROVIDER=mock
SPEECH_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_FALLBACK_TO_MOCK=false
