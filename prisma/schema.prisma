// Vaani AI — Prisma schema.
// Phase 1 introduces only the models required for auth, users, and language selection.
// Remaining domain models (Conversation, Course, Progress, …) are added in their phases
// so migrations stay meaningful and tables aren't created before they're used.
// See docs/IMPLEMENTATION_PLAN.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum LearningLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum ConversationTopic {
  DAILY
  TRAVEL
  JOB_INTERVIEW
  WORKPLACE
  SHOPPING
  RESTAURANT
  FRIENDS
  TECHNOLOGY
  FREE
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ConversationMode {
  CHAT
  ROLEPLAY
  DIALOGUE
  CHARACTER
  SCENARIO
}

// ── Advanced AI Modes (Phase 8) ─────────────────────────────────────────────
enum DebateSide {
  FOR
  AGAINST
}

enum DebateStatus {
  ACTIVE
  CLOSED
}

// Practice categories; only CHAT is produced in Phase 3. Others are added with their features.
enum PracticeKind {
  CHAT
  ROLEPLAY
  CALL
  DIALOGUE
  SENTENCE
  WORD
  PHOTO
  DEBATE
  CHARACTER
  SCENARIO
}

// ── Meeting Intelligence (Phase 7B) ─────────────────────────────────────────
// A MOCK/prototype module: scheduling, consent-gated recording *state*, and
// analysis produced by a mock provider. NO real Teams/AVD/desktop/audio capture
// is implemented here (deferred pending environment validation).

enum MeetingProvider {
  TEAMS
  AVD
  OTHER
}

enum RecordingState {
  IDLE
  RECORDING
  PAUSED
  STOPPED
}

enum MeetingAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
}

// ── Courses (Phase 9) ───────────────────────────────────────────────────────
enum ExerciseKind {
  MULTIPLE_CHOICE
  FILL_BLANK
  TRANSLATE
  FREE_RESPONSE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

// ── Flashcards (vocabulary decks + spaced-repetition review) ─────────────────
/// The learner's self-graded result for one flashcard review, feeding the simple
/// spaced-repetition scheduler (SM-2-inspired, kept deliberately small).
enum FlashcardResult {
  AGAIN
  GOOD
  EASY
}

// ── Progress + Analytics (Phase 10) ──────────────────────────────────────────
/// A category of learning activity recorded when a feature completes. Feeds the
/// Progress dashboard aggregation (learning minutes, sessions-by-type, weekly series).
enum ActivityKind {
  CHAT
  ROLEPLAY
  CALL
  DIALOGUE
  WORD
  SENTENCE
  FLASHCARD
  COURSE
  DEBATE
  PHOTO
  CHARACTER
  SCENARIO
  MEETING
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          Profile?
  sessions         Session[]
  userLanguages    UserLanguage[]
  conversations    Conversation[]
  practiceSessions PracticeSession[]
  meetings         Meeting[]
  meetingSettings  MeetingSettings?
  debates          Debate[]
  photoSessions    PhotoSession[]
  courseEnrollments CourseEnrollment[]
  lessonProgress    LessonProgress[]
  flashcardDecks    FlashcardDeck[]
  flashcardReviews  FlashcardReview[]
  activityEvents    ActivityEvent[]
  achievements      UserAchievement[]

  @@index([email])
}

model Profile {
  id                   String          @id @default(cuid())
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Currently-selected learning language (nullable until onboarding completes).
  learningLanguageCode String?
  learningLanguage     Language?       @relation("ProfileLearningLanguage", fields: [learningLanguageCode], references: [code])
  nativeLanguageCode   String?
  level                LearningLevel   @default(BEGINNER)
  dailyGoalMinutes     Int             @default(30)
  theme                ThemePreference @default(SYSTEM)
  timezone             String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([learningLanguageCode])
}

model Language {
  code       String   @id // e.g. "en", "es", "ta"
  name       String // English name
  nativeName String // endonym
  flagEmoji  String
  rtl        Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  profilesLearning Profile[]      @relation("ProfileLearningLanguage")
  userLanguages    UserLanguage[]
  conversations    Conversation[]
}

/// Languages a user is actively learning (a user may learn several over time).
model UserLanguage {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageCode String
  language     Language      @relation(fields: [languageCode], references: [code], onDelete: Cascade)
  level        LearningLevel @default(BEGINNER)
  isPrimary    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, languageCode])
  @@index([userId])
}

/// Persisted refresh sessions. The refresh token is stored hashed so it can be
/// revoked (logout) and cannot be used if the database leaks.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

/// An AI Chat conversation (Phase 3). Groups an ordered list of messages.
model Conversation {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageCode String
  language     Language          @relation(fields: [languageCode], references: [code])
  mode         ConversationMode  @default(CHAT)
  topic        ConversationTopic @default(FREE)
  // For ROLEPLAY/DIALOGUE/SCENARIO modes: identifies the static scenario.
  scenarioKey  String?
  // For CHARACTER mode: the persona driving the conversation (Phase 8).
  characterId  String?
  character    AICharacter?      @relation(fields: [characterId], references: [id], onDelete: SetNull)
  level        LearningLevel     @default(BEGINNER)
  title        String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  messages         ConversationMessage[]
  practiceSessions PracticeSession[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([characterId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Records that a practice activity happened (Phase 3 creates these for chat).
/// Progress/analytics (Phase 8) aggregates them.
model PracticeSession {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            PracticeKind
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  durationSeconds Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([userId, createdAt])
}

/// A scheduled meeting (Phase 7B). Owns its participants, a single recording
/// session, an optional transcript, and — after mock analysis — a summary,
/// decisions, and action items.
model Meeting {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  provider             MeetingProvider       @default(TEAMS)
  scheduledStart       DateTime
  scheduledEnd         DateTime
  recordingEnabled     Boolean               @default(false)
  transcriptionEnabled Boolean               @default(false)
  aiAnalysisEnabled    Boolean               @default(true)
  analysisStatus       MeetingAnalysisStatus @default(PENDING)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  participants MeetingParticipant[]
  recording    RecordingSession?
  transcript   Transcript?
  summary      MeetingSummary?
  decisions    MeetingDecision[]
  actionItems  ActionItem[]

  @@index([userId])
  @@index([userId, scheduledStart])
}

/// A meeting participant. `speakerLabel` links a participant to transcript
/// segments in the mock pipeline. Participants are supplied at schedule time —
/// the analyzer NEVER invents new ones.
model MeetingParticipant {
  id           String  @id @default(cuid())
  meetingId    String
  meeting      Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  role         String?
  speakerLabel String?

  @@index([meetingId])
}

/// Consent-gated recording lifecycle. State transitions only — this phase does
/// NOT capture real audio/video. A session cannot enter RECORDING without
/// `recordingConsent = true`.
model RecordingSession {
  id               String         @id @default(cuid())
  meetingId        String         @unique
  meeting          Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  state            RecordingState @default(IDLE)
  recordingConsent Boolean        @default(false)
  transcriptConsent Boolean       @default(false)
  startedAt        DateTime?
  endedAt          DateTime?
  durationSeconds  Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

/// A meeting transcript (mock). Composed of ordered speaker-labelled segments.
model Transcript {
  id        String              @id @default(cuid())
  meetingId String              @unique
  meeting   Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  language  String?
  createdAt DateTime            @default(now())
  segments  TranscriptSegment[]
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  speakerLabel String
  text         String     @db.Text
  startMs      Int
  endMs        Int
  ordinal      Int

  @@index([transcriptId, ordinal])
}

/// Narrative analysis for a meeting. Arrays are stored as string[] columns.
model MeetingSummary {
  id               String   @id @default(cuid())
  meetingId        String   @unique
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  overview         String   @db.Text
  discussionPoints String[]
  risks            String[]
  questions        String[]
  nextSteps        String[]
  createdAt        DateTime @default(now())
}

/// A key decision extracted from the (mock) transcript. `decidedBy` is
/// `Unassigned` when the transcript does not attribute it.
model MeetingDecision {
  id          String  @id @default(cuid())
  meetingId   String
  meeting     Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  description String  @db.Text
  decidedBy   String  @default("Unassigned")
  confidence  Float   @default(0)

  @@index([meetingId])
}

/// An action item extracted from the (mock) transcript. `owner` defaults to
/// `Unassigned` and `dueDate` to `Not specified` when unsupported by the transcript.
model ActionItem {
  id          String             @id @default(cuid())
  meetingId   String
  meeting     Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  ordinal     Int
  description String             @db.Text
  owner       String             @default("Unassigned")
  dueDate     String             @default("Not specified")
  status      ActionItemStatus   @default(OPEN)
  priority    ActionItemPriority @default(MEDIUM)
  confidence  Float              @default(0)

  @@index([meetingId, ordinal])
}

/// Per-user privacy defaults for meeting recording/transcription.
model MeetingSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordingConsent Boolean  @default(false)
  transcriptConsent Boolean @default(false)
  autoRecord       Boolean  @default(false)
  autoTranscribe   Boolean  @default(false)
  retentionDays    Int      @default(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── Advanced AI Modes (Phase 8) ─────────────────────────────────────────────

/// A predefined AI persona for Character conversations (Phase 8). Seeded content;
/// `persona` shapes the AI system prompt and is never shown to the learner directly.
/// Character chats reuse the Conversation/ConversationMessage pipeline (mode = CHARACTER).
model AICharacter {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  tagline     String
  description String   @db.Text
  setting     String
  avatarEmoji String
  greeting    String   @db.Text
  persona     String   @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  conversations Conversation[]
}

/// A Debate session (Phase 8): the learner argues one side of a motion, the AI argues
/// the other across turns, then structured feedback is produced by the @vaani/ai
/// abstraction. `topicKey` references a static topic in @vaani/types.
model Debate {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageCode String
  topicKey     String
  motion       String        @db.Text
  userSide     DebateSide
  level        LearningLevel @default(BEGINNER)
  status       DebateStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  messages DebateMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model DebateMessage {
  id        String      @id @default(cuid())
  debateId  String
  debate    Debate      @relation(fields: [debateId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([debateId, createdAt])
}

/// A Photo conversation (Phase 8): the learner supplies an image (data-URL or remote
/// URL, stored as-is — no heavy upload pipeline), a MOCK vision method produces a
/// description, and the AI converses about it. No real image analysis happens here.
model PhotoSession {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageCode String
  imageUrl     String        @db.Text
  description  String        @db.Text
  level        LearningLevel @default(BEGINNER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  messages PhotoMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model PhotoMessage {
  id             String       @id @default(cuid())
  photoSessionId String
  photoSession   PhotoSession @relation(fields: [photoSessionId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([photoSessionId, createdAt])
}

// ── Courses (Phase 9) ───────────────────────────────────────────────────────

/// A structured learning course (Phase 9, master plan §17). Seeded product content
/// grouping modules → lessons → exercises. `languageCode` is the language the course
/// teaches. Learners enroll to track progress.
model Course {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String        @db.Text
  languageCode    String
  level           LearningLevel @default(BEGINNER)
  coverEmoji      String        @default("📘")
  estimatedMinutes Int          @default(0)
  sortOrder       Int           @default(0)
  isPublished     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  modules     CourseModule[]
  enrollments CourseEnrollment[]

  @@index([languageCode])
  @@index([isPublished, sortOrder])
}

/// An ordered section within a course grouping related lessons.
model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  ordinal     Int
  createdAt   DateTime @default(now())

  lessons Lesson[]

  @@index([courseId, ordinal])
}

/// A single lesson within a module. `content` holds the teaching material (markdown-ish
/// text); exercises reinforce it. Learners mark lessons complete to advance progress.
model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  content     String   @db.Text
  ordinal     Int
  estimatedMinutes Int @default(5)
  createdAt   DateTime @default(now())

  exercises Exercise[]
  progress  LessonProgress[]

  @@index([moduleId, ordinal])
}

/// An exercise attached to a lesson. `options` (for MULTIPLE_CHOICE) is a string[]; the
/// canonical `answer` is used for deterministic grading, while FREE_RESPONSE/TRANSLATE
/// exercises are evaluated through the @vaani/ai abstraction.
model Exercise {
  id          String       @id @default(cuid())
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind        ExerciseKind @default(MULTIPLE_CHOICE)
  prompt      String       @db.Text
  options     String[]
  answer      String       @db.Text
  explanation String       @db.Text @default("")
  ordinal     Int
  createdAt   DateTime     @default(now())

  @@index([lessonId, ordinal])
}

/// A learner's enrollment in a course. Progress is derived from LessonProgress rows.
model CourseEnrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
  @@index([userId])
}

/// Records that a learner completed a lesson (Phase 9). Aggregated into course progress.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
}

// ── Flashcards ───────────────────────────────────────────────────────────────

/// A vocabulary flashcard deck. A deck is either a shared *system* deck (`userId`
/// null, seeded product content) or a *user-owned* deck (e.g. AI-generated for a
/// topic). Distinct from Word mode: decks carry a title/description and are studied
/// with a spaced-repetition review flow. `languageCode` is the language being learned.
model FlashcardDeck {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text @default("")
  languageCode String
  /// Null for shared system decks; set for a learner's own (or AI-generated) deck.
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// True for seeded/shared decks visible to everyone.
  isSystem     Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cards Flashcard[]

  @@index([userId])
  @@index([isSystem, sortOrder])
}

/// A single card in a deck: the `term`/front (in the target language) and its
/// `translation`/back, with an optional example sentence for context.
model Flashcard {
  id        String   @id @default(cuid())
  deckId    String
  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  term      String
  translation String
  example   String?  @db.Text
  ordinal   Int      @default(0)
  createdAt DateTime @default(now())

  reviews FlashcardReview[]

  @@index([deckId, ordinal])
}

/// Per-user spaced-repetition state for one flashcard (SM-2-inspired). `ease` scales
/// the interval growth, `intervalDays` is the current spacing, and `dueAt` is when the
/// card should next be reviewed. Updated each time the learner grades a card.
model FlashcardReview {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId  String
  flashcard    Flashcard       @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  ease         Float           @default(2.5)
  intervalDays Int             @default(0)
  repetitions  Int             @default(0)
  dueAt        DateTime        @default(now())
  lastResult   FlashcardResult?
  lastReviewedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([userId, flashcardId])
  @@index([userId, dueAt])
}

// ── Progress + Analytics (Phase 10) ──────────────────────────────────────────

/// A lightweight, persisted record that a learning activity completed. Feature
/// services append one of these at the natural completion point of an activity
/// (a message sent, a card reviewed, a lesson completed, a meeting analyzed, …).
/// The Progress module aggregates these into totals, a streak, and a weekly series.
/// `minutes` is an estimated duration credited to the activity; `xp` is experience
/// awarded. Both are small fixed amounts per activity kind (deterministic).
model ActivityEvent {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ActivityKind
  minutes   Int          @default(0)
  xp        Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

/// A seeded achievement definition (original Vaani AI content). Unlock logic lives in
/// the progress service; `code` is a stable slug the service checks against.
model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String   @db.Text
  icon        String   @default("🏆")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

/// Join row recording that a learner unlocked an achievement, and when.
model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}
